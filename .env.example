# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_DASHBOARD_CHANNEL_ID=your_channel_id_here

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/bot.log
LOG_MAX_FILE_SIZE=10485760
LOG_BACKUP_COUNT=5

# Network Configuration
FUTBIN_NET_REQUEST_TIMEOUT=12.0
FUTBIN_NET_RETRY_COUNT=2
FUTBIN_NET_MAX_CONCURRENT_REQUESTS=3

# Task Configuration
FUTBIN_TASK_DASHBOARD_UPDATE_INTERVAL=300
FUTBIN_TASK_PRICE_CHECK_INTERVAL=280

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
PORT=8080
HEALTH_BIND_ADDRESS=0.0.0.0

# FutBin Configuration (pc, ps, xbox)
FUTBIN_GLOBAL_THRESHOLD_PERCENT=5.0
FUTBIN_PLATFORM=pc
