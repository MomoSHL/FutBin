[Unit]
Description=FUTBin Discord Bot Service
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fifa
Group=fifa

# Arbeitsverzeichnis
WorkingDirectory=/home/fifa/botBin

# Startbefehl mit der virtuellen Python-Umgebung
ExecStart=/home/fifa/botBin/.venv/bin/python /home/fifa/botBin/main.py

# Automatischer Neustart bei Fehlern oder Verbindungsabbrüchen
Restart=always
RestartSec=10

# Umgebungsvariablen
Environment=PYTHONUNBUFFERED=1
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8

# Standard-Logging an journalctl
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
